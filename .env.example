# openclow 平台配置
OPENCLOW_BASE_URL=http://103.236.98.200:8000
OPENCLOW_API_KEY=<your_api_key>

# 业务应用配置
APP_PORT=8600
APP_HOST=0.0.0.0

# 运维助手自身 API Key（为空时不校验，建议生产环境设置；多用户时改用下面 OPS_ASSISTANT_USERS）
OPS_ASSISTANT_API_KEY=

# 多用户：user_id -> api_key 映射（JSON）。配置后身份由 X-API-Key 决定，忽略 X-User-Id 头。
# OPS_ASSISTANT_USERS={"alice":"ops_key_alice","bob":"ops_key_bob"}

# 会话持久化数据库路径
OPS_SESSION_DB_PATH=./data/sessions.db
OPS_AUDIT_DB_PATH=./data/tool_audit.db

# Query 改写：遇到这些指代词时才触发
REWRITE_TRIGGER_WORDS=它,这个,那个,他,她,这,那,前面,刚才

# RAG 默认检索参数
RAG_TOP_K=5
RAG_RERANK=false

# 真实业务指标：后台健康巡检（真实 incident 来源，不依赖真人）
# OPS_MONITOR_ENABLED=true          # 是否开启后台健康巡检
# OPS_MONITOR_INTERVAL_S=60        # 巡检间隔（秒）
# OPS_MONITOR_AUTO_DIAGNOSE=true   # 巡检发现异常后是否自动调 agent 诊断该 incident
# OPS_INCIDENT_USER=system         # incident 归属的用户（多用户隔离，默认 system）
# 巡检靶点：name -> url（JSON），默认探 openclow 平台与前端（见下方 OPS_TARGET_*）
# OPS_MONITOR_TARGETS={"openclow-api":"http://103.236.98.200:8000/health","openclow-ui":"http://103.236.98.200:8501"}
