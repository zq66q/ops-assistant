[Unit]
Description=ops-assistant — openclow 运维排障助手
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ops-assistant
Environment="PATH=/opt/miniconda/envs/openclaw/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/opt/ops-assistant/.env
ExecStart=/opt/miniconda/envs/openclaw/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
